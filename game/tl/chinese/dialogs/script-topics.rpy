translate chinese s_answer_reality_ee6099fb:

    # s bbbbaca "Just look at me and the other girls. We all had our pros and cons."
    s bbbbaca "光看看我和其他女孩们，我们都有自己的优缺点。"

# game/dialogs/script-topics.rpy:2155
translate chinese s_answer_reality_784e1b55:

    # s abbbcoa "But that aside, I really wish I can visit your reality someday!"
    s abbbcoa "不过抛开这些，我还是很希望哪天能来到你的世界！"

