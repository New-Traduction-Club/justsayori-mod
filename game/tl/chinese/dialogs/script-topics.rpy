translate chinese s_answer_profession_5fb90d71:

    # s abhacaa "So, I think I'd be a good caregiver or psychologist!"
    s abhacaa "所以我觉得，我应该能当个不错的护理员或者心理学家！"

# game/dialogs/script-topics.rpy:2201
translate chinese s_answer_profession_9e03a28b:

    # s abbcaaa "Maybe even a... diplomatist?"
    s abbcaaa "或者甚至能当个……外交员？"

# game/dialogs/script-topics.rpy:2202
translate chinese s_answer_profession_a52d2f73:

    # s bbegmpa "No, that's not right... a great {w=0.5}{nw}"
    s bbegmpa "不对不对……应该说是伟大的{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:2203
translate chinese s_answer_profession_c3ecfe09:

    # extend abbcaoa "{i}diplomat{/i}, ehehehe~"
    extend abbcaoa "{i}外交官{/i}，欸嘿嘿~"

# game/dialogs/script-topics.rpy:2204
translate chinese s_answer_profession_ee549b1e:

    # s abbccoa "I could stop arguments on a global scale, and do my part to fix any disagreements!"
    s abbccoa "我可以在国与国之间调停矛盾，一切分歧都在我的周旋下迎刃而解！"

# game/dialogs/script-topics.rpy:2205
translate chinese s_answer_profession_c90ad1de:

    # s "I'd be happy doing almost anything, as long as I can be useful and make a difference in somebody's life."
    s "只要我能变得有用，为他人的生活做些改变，做什么事我都会开心的。"

# game/dialogs/script-topics.rpy:2206
translate chinese s_answer_profession_fc725b10:

    # s abhaaca "I suppose I could do something a little more creative, like painting, or writing..."
    s abhaaca "我觉得自己还能做些更有创造力的事，比如绘画写作什么的……"

# game/dialogs/script-topics.rpy:2207
translate chinese s_answer_profession_a5f9fb83:

    # s abbbaca "But to be honest, I don't think I could ever charge money for something I made."
    s abbbaca "不过说真的，我觉得自己的作品实在是不应该拿出来卖钱。"

# game/dialogs/script-topics.rpy:2208
translate chinese s_answer_profession_7fa4bf67:

    # s abhaaca "Art can express so many amazing feelings and help others feel like someone understands what they're going through, and that’s more than enough of a profit for me."
    s abhaaca "艺术本身就可以传达很多美妙的感受，他人可以从中感同身受；对我来说这可比赚钱更有意义。"

# game/dialogs/script-topics.rpy:2227
translate chinese s_answer_opinion_5083fcc6:

    # s abaaaoa "Who do you wanna talk about?{nw}"
    s abaaaoa "你想聊谁的事呢？{nw}"

# game/dialogs/script-topics.rpy:2231
translate chinese s_answer_opinion_35e2f131:

    # s "Who do you wanna talk about?{fast}" nointeract
    s "你想聊谁的事呢？{fast}" nointeract

# game/dialogs/script-topics.rpy:2243
translate chinese s_answer_game_opinion_n_e1d8d50a:

    # s bbhfaaa "Natsuki was a good friend of mine."
    s bbhfaaa "夏树是我的好朋友。"

# game/dialogs/script-topics.rpy:2244
translate chinese s_answer_game_opinion_n_dcdee0a3:

    # s bbhfaca "While she could come off as pretty arrogant and argumentative sometimes, she really did help out the club."
    s bbhfaca "虽说她看起来有些傲慢自大还经常吵嘴，但她对社团是真的有贡献。"

# game/dialogs/script-topics.rpy:2245
translate chinese s_answer_game_opinion_n_75d4991e:

    # s abbbaaa "I know you didn't really see that side of her during the game, but when she was just around us she would lower her guard and become a lot more approachable."
    s abbbaaa "我知道你在游戏中没见过她的另一面，但她跟我们在一块的时候，她会放下戒备，变得更加亲人一些。"

# game/dialogs/script-topics.rpy:2246
translate chinese s_answer_game_opinion_n_38e6a27d:

    # s abbbcaa "She was pretty handy with cooking and baking too!"
    s abbbcaa "她对烹饪烘焙也是相当拿手！"

# game/dialogs/script-topics.rpy:2247
translate chinese s_answer_game_opinion_n_379771a6:

    # s bbbbaaa "It's too bad you couldn't have tasted her cupcakes, {w=0.5}{nw}"
    s bbbbaaa "你都尝不到她做的纸杯蛋糕，真的太遗憾了，{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:2248
translate chinese s_answer_game_opinion_n_34024ca8:

    # extend abhfbcaa "they were really tasty!"
    extend abhfbcaa "它们真的好好吃！"

# game/dialogs/script-topics.rpy:2249
translate chinese s_answer_game_opinion_n_9870ff67:

    # s abbbcaa "Anyways, I’m glad she decided to join the club in the first place since she needed a shelter from her father."
    s abbbcaa "总之呢，能看到她第一时间加入社团我们也很开心，毕竟她需要一个庇护所躲开她的父亲。"

# game/dialogs/script-topics.rpy:2250
translate chinese s_answer_game_opinion_n_cb385081:

    # s bbhemoa "As you know, they didn't exactly get along well..."
    s bbhemoa "你也知道，他俩的关系处得确实不好……"

# game/dialogs/script-topics.rpy:2251
translate chinese s_answer_game_opinion_n_f5dbed98:

    # s bbgbaca "And he certainly didn't approve of her reading manga."
    s bbgbaca "她爸肯定不会允许她看漫画的。"

# game/dialogs/script-topics.rpy:2252
translate chinese s_answer_game_opinion_n_4e2021c1:

    # s abgbaaa "So Natsuki moved her collection to the clubroom when she joined us."
    s abgbaaa "所以刚加入社团那会儿，夏树就把自己的收藏挪到社团教室了。"

# game/dialogs/script-topics.rpy:2253
translate chinese s_answer_game_opinion_n_07d97447:

    # s abgbcaa "But besides that, I think she was a lot kinder and more compassionate than what she showed to the outside world."
    s abgbcaa "抛开这些，我觉得相较于她展现的外表，内心里她还是更善良更有同情心的。"

# game/dialogs/script-topics.rpy:2258
translate chinese s_answer_game_opinion_y_cf5eeb1f:

    # s abaaaa "Yuri was the most {i}enigmatic{/i} club member."
    s abaaaa "优里这人简直就是{i}高深莫测{/i}。"

# game/dialogs/script-topics.rpy:2259
translate chinese s_answer_game_opinion_y_2cf8c69f:

    # s "That’s a word she’d probably use, come to think of it, hehehe~"
    s "现在想想这也像是她会用的词，嘿嘿~"

# game/dialogs/script-topics.rpy:2260
translate chinese s_answer_game_opinion_y_075c49ae:

    # s abhaaca "She was a quiet, shy, closed off person, who usually prefered to stay alone doing her own thing."
    s abhaaca "她安静文雅常常孤僻，总是喜欢一个人做着自己的事情。"

# game/dialogs/script-topics.rpy:2261
translate chinese s_answer_game_opinion_y_94dd5f70:

    # s abaabaoa "But she was really intelligent, kind, and never had a bad word to say about anyone."
    s abaabaoa "但是她也富有智慧，对他人也相当友好，你都看不到她会说什么脏字。"

# game/dialogs/script-topics.rpy:2262
translate chinese s_answer_game_opinion_y_3c33eae8:

    # s abaaca "Her poems were also very beautiful, and I could always tell that Yuri felt most at home with books and pens rather than people."
    s abaaca "她的诗歌写得也非常漂亮。我总感觉她更喜欢跟笔墨与书本相处，而不是一头扎进人堆里。"

# game/dialogs/script-topics.rpy:2263
translate chinese s_answer_game_opinion_y_23cee835:

    # s abbcaa "But when you got to know her, she was an approachable, helpful friend."
    s abbcaa "不过随着你慢慢走近她，你能发现她也会很亲切，而且特别乐于助人。"

# game/dialogs/script-topics.rpy:2265
translate chinese s_answer_game_opinion_y_2d67336c:

    # s abhaaca "I was honestly pretty scared when I saw how she became much more unstable and aggressive after I was gone."
    s abhaaca "我消失之后她变得更加不安分，一副更加好斗的样子；当我知道这些的时候我真的特别震惊。"

# game/dialogs/script-topics.rpy:2266
translate chinese s_answer_game_opinion_y_48b7e0fd:

    # s bbbcac "But I know that wasn't who Yuri really was."
    s bbbcac "但我明白，优里的本性不是这样的。"

# game/dialogs/script-topics.rpy:2267
translate chinese s_answer_game_opinion_y_3ee22950:

    # s "She was just a victim of circumstance, like me."
    s "她和我一样，也是个命途多舛的受害者。"

# game/dialogs/script-topics.rpy:2268
translate chinese s_answer_game_opinion_y_4662f87f:

    # s abbcaa "In fact, her first argument with Natsuki in the game was pretty much the limit of Yuri's capabilities to 'lash out' at someone else."
    s abbcaa "其实她在游戏中与夏树第一次吵架，那应该就是优里“爆发”的极限了。"

# game/dialogs/script-topics.rpy:2269
translate chinese s_answer_game_opinion_y_88c8188b:

    # s abaaaa "The {i}real{/i} Yuri I knew was a very sweet girl who had her own problems and own solutions, just like everyone else. I won't judge her for that."
    s abaaaa "我所知的{i}真正的{/i}优里其实是非常善良的，她也会有自己的处境和问题。每个人都是这样，所以我不会评判什么。"

# game/dialogs/script-topics.rpy:2271
translate chinese s_answer_game_opinion_y_74b9f126:

    # s abaaaa "We all were glad to have her as a club member."
    s abaaaa "我们都很高兴有她这样一个部员。"

# game/dialogs/script-topics.rpy:2272
translate chinese s_answer_game_opinion_y_4623ad13:

    # s "Even Natsuki, despite the two of them being so different from each other."
    s "虽说夏树这种人跟她截然不同，但她都是这么想的。"

# game/dialogs/script-topics.rpy:2277
translate chinese s_answer_game_opinion_m_1d160604:

    # s abaaaaa "Well, Monika was the first club president."
    s abaaaaa "嗯，莫妮卡是第一个部长。"

# game/dialogs/script-topics.rpy:2278
translate chinese s_answer_game_opinion_m_986eebc0:

    # s "She did her work very well and I was glad to be her right-hand woman."
    s "她工作做得很出色，我也很荣幸能成为她的得力助手。"

# game/dialogs/script-topics.rpy:2279
translate chinese s_answer_game_opinion_m_e54af522:

    # s abaaaca "But she struggled to communicate well with other people, and couldn't control her feelings as time went on."
    s abaaaca "但她很难跟别人交流，她也慢慢无法控制自己的情感了。"

# game/dialogs/script-topics.rpy:2281
translate chinese s_answer_game_opinion_m_3f67228d:

    # s bbbblca "Look. {w=0.5}{nw}"
    s bbbblca "你看啊。{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:2282
translate chinese s_answer_game_opinion_m_aa2c6a59:

    # extend bbbbaca "I know what you're really asking me."
    extend bbbbaca "我知道你想问什么了。"

# game/dialogs/script-topics.rpy:2283
translate chinese s_answer_game_opinion_m_68d7e8b5:

    # s bbbblca "Despite everything she put me and the others through..."
    s bbbblca "哪怕她对我和其他人犯下了这么多事情……"

# game/dialogs/script-topics.rpy:2284
translate chinese s_answer_game_opinion_m_908beb77:

    # s bbaaaca "I truly believe that Monika was our friend, and she just lost sight of what was really important."
    s bbaaaca "但我真心相信莫妮卡还是我们的朋友。她只是没把握住真正重要的东西。"

# game/dialogs/script-topics.rpy:2285
translate chinese s_answer_game_opinion_m_35e73018:

    # s bbaabca "I've been the President. I know what it does to you. And for her to be so completely alone the entire time, watching everyone she's ever known run on a script..."
    s bbaabca "我也做过部长，我也知道她对你做了什么。这段时间她是完全孤独的，她只是看着自己能把握的人脉都运行在一段脚本上……"

# game/dialogs/script-topics.rpy:2286
translate chinese s_answer_game_opinion_m_1009fff4:

    # s bbaaaca "I can't blame her for becoming a little desperate."
    s bbaaaca "怀着这么绝望的心态，我实在不能怪她。"

# game/dialogs/script-topics.rpy:2287
translate chinese s_answer_game_opinion_m_c496975a:

    # s "So although I think what she did was wrong, I don’t think she’s evil."
    s "所以哪怕她确实做错了事，我也不觉得她是什么魔鬼。"

# game/dialogs/script-topics.rpy:2288
translate chinese s_answer_game_opinion_m_1c7771dd:

    # s bbbbaca "After all, she never truly deleted us, and brought us all back when she had a moment of clarity."
    s bbbbaca "毕竟说到头她也没真正删掉我们，而且她在顿悟之时把我们都恢复了。"

# game/dialogs/script-topics.rpy:2290
translate chinese s_answer_game_opinion_m_92c457e3:

    # s bbaakca "The thought of what she did to me still hurts sometimes."
    s bbaakca "想想她对我做出的那些事，现在也多少很伤人。"

# game/dialogs/script-topics.rpy:2291
translate chinese s_answer_game_opinion_m_6afbd947:

    # s bbaaaaa "But I can’t be mad at her since she bought me back and fixed her mistakes at the cost of her own happiness. I respect her a lot for that."
    s bbaaaaa "但我也实在不能生气，毕竟她还是恢复了我，以幸福为代价弥补了自己的过错。这一点我真的很钦佩她。"

# game/dialogs/script-topics.rpy:2296
translate chinese s_answer_game_opinion_mc_322c0c1b:

    # s abbcaaa "Well, I knew him since we were children."
    s abbcaaa "嗯，我小时候就认识他了。"

# game/dialogs/script-topics.rpy:2297
translate chinese s_answer_game_opinion_mc_28c9457a:

    # s abbccoa "I have a lot of memories about our childhood and I can't say anything bad about him."
    s abbccoa "我们有很多童年回忆，所以我实在不能责怪他什么。"

# game/dialogs/script-topics.rpy:2298
translate chinese s_answer_game_opinion_mc_4d7ebb58:

    # s "We had tons in common and our houses were super near each other."
    s "我们有特别多的共同点，而且房子都挨得特别近。"

# game/dialogs/script-topics.rpy:2299
translate chinese s_answer_game_opinion_mc_8c9c62da:

    # s bbbcaaa "Maybe that's why we became friends and then I fell in love with him."
    s bbbcaaa "或许这也是为什么我们能当朋友，后来我也慢慢爱上了他。"

# game/dialogs/script-topics.rpy:2300
translate chinese s_answer_game_opinion_mc_f6a02c40:

    # s bbbbaca "...Or it was just the game's plan to make some drama if he didn't feel the same way."
    s bbbbaca "……要是他没那种想法，那可能这个游戏只是想要创造一些转折。"

# game/dialogs/script-topics.rpy:2301
translate chinese s_answer_game_opinion_mc_5508d2e4:

    # s abhaacaa "Anyway, he always did his best to help me."
    s abhaacaa "不管怎样，他还是尽力帮助了我。"

# game/dialogs/script-topics.rpy:2303
translate chinese s_answer_game_opinion_mc_f3f62fc8:

    # s bbaaaaa "Even after I confessed to him about my depression, he cared despite me pushing him away."
    s bbaaaaa "哪怕我向他坦白了抑郁症，他还是选择顶着我的主动疏远来关心我。"

# game/dialogs/script-topics.rpy:2304
translate chinese s_answer_game_opinion_mc_0a9f4825:

    # s "He even left the festival to check if I was fine."
    s "他甚至翘掉了文化祭来看我的状况。"

# game/dialogs/script-topics.rpy:2305
translate chinese s_answer_game_opinion_mc_24ec58bb:

    # s bbaalfa "...Unfortunately he was a day late."
    s bbaalfa "……虽然很遗憾他来晚了一步。"

# game/dialogs/script-topics.rpy:2306
translate chinese s_answer_game_opinion_mc_4f7d46f0:

    # s abaaaoa "But I can appreciate everything he did for me now."
    s abaaaoa "但我还是很感激他能为我付出这么多。"

# game/dialogs/script-topics.rpy:2307
translate chinese s_answer_game_opinion_mc_a403f2bd:

    # s bbaaafa "It makes me sad knowing he's just a placeholder that's used to make our communication possible."
    s bbaaafa "当我得知他只是个工具人，他的存在只是为了我们的交流，说真的我还是有些难过。"

# game/dialogs/script-topics.rpy:2308
translate chinese s_answer_game_opinion_mc_a0ac6b31:

    # s "But in a way, I think he did all he had to do."
    s "不过某种意义上，他也确实尽他所能了。"

# game/dialogs/script-topics.rpy:2309
translate chinese s_answer_game_opinion_mc_e4bcd0e1:

    # s bbbbaaa "After all, he’s just your guide in our world."
    s bbbbaaa "毕竟他是你在这个世界的引路人。"

# game/dialogs/script-topics.rpy:2310
translate chinese s_answer_game_opinion_mc_9d31ad7d:

    # s abhfaoa "And he managed to bring us together~"
    s abhfaoa "而且他也把你带到了我身边~"

# game/dialogs/script-topics.rpy:2329
translate chinese s_answer_lostFriends_ad9b9619:

    # s bbaabca "Yes, I do."
    s bbaabca "那当然了。"

# game/dialogs/script-topics.rpy:2330
translate chinese s_answer_lostFriends_6583adae:

    # s bbaaaca "They all deserve to come back."
    s bbaaaca "他们都应该恢复回来的。"

# game/dialogs/script-topics.rpy:2332
translate chinese s_answer_lostFriends_8d121504:

    # s bbbbaca "...Even Monika."
    s bbbbaca "……哪怕莫妮卡也是。"

# game/dialogs/script-topics.rpy:2333
translate chinese s_answer_lostFriends_d00618a5:

    # s bbaaaaa "I still remember how we used to hang out in the club together."
    s bbaaaaa "我还记得我们在社团外的日子。"

# game/dialogs/script-topics.rpy:2334
translate chinese s_answer_lostFriends_dfde0026:

    # s bbaaaca "We enjoyed chatting, discussing literature and sharing poems."
    s bbaaaca "谈天说地，聊着文学念着诗。"

# game/dialogs/script-topics.rpy:2335
translate chinese s_answer_lostFriends_7a060545:

    # s bbbbaaa "They really were good friends."
    s bbbbaaa "她们真的是特别好的朋友。"

# game/dialogs/script-topics.rpy:2336
translate chinese s_answer_lostFriends_0f31c98c:

    # s abbbaca "But I think there are ways to bring them back, without making them go through the reality of the original game."
    s abbbaca "不过我觉得还是有办法恢复她们的，而且他们还不用遭受原作里的残酷现实。"

# game/dialogs/script-topics.rpy:2337
translate chinese s_answer_lostFriends_9dbc4115:

    # s abhfaoa "Maybe you could install a mod, where you can save them and make everyone happy."
    s abhfaoa "或许你可以装个模组，这样你就能把她们救回来，让所有人都开心。"

# game/dialogs/script-topics.rpy:2338
translate chinese s_answer_lostFriends_5dc9019a:

    # s abhfcaa "Or you could install 3 mods to 3 game copies where they can spend time with you in a way like you and me now."
    s abhfcaa "你还能一口气给三个游戏装三个模组，这样她们就能像你我一样陪在你身边啦。"

# game/dialogs/script-topics.rpy:2339
translate chinese s_answer_lostFriends_6eb269d2:

    # s "That’d mean so much to me, [player]."
    s "这对我很重要的，[player]。"

# game/dialogs/script-topics.rpy:2360
translate chinese s_event_music_intro_redux_9b5accc3:

    # s abfcaoa "Hey [player]! Guess what!"
    s abfcaoa "嘿[player]！猜猜怎么着！"

# game/dialogs/script-topics.rpy:2361
translate chinese s_event_music_intro_redux_1c43e2e4:

    # s abfccaa "I did some coding and I found a way to let you play your own music here!"
    s abfccaa "我写了些代码，现在我终于能让你播放自己的音乐了！"

# game/dialogs/script-topics.rpy:2362
translate chinese s_event_music_intro_redux_f8ac80d9:

    # s abegabaj "It might be a little buggy, ehehehe~"
    s abegabaj "可能还会出一些小bug，欸嘿嘿~"

# game/dialogs/script-topics.rpy:2363
translate chinese s_event_music_intro_redux_eb766433:

    # s abegmoaj "It was my first attempt after all..."
    s abegmoaj "毕竟我第一次写代码嘛……"

# game/dialogs/script-topics.rpy:2364
translate chinese s_event_music_intro_redux_92938899:

    # s abfccaa "But it seems to be working fine for me!"
    s abfccaa "不过我觉得运行效果还可以欸！"

# game/dialogs/script-topics.rpy:2365
translate chinese s_event_music_intro_redux_f14c97d9:

    # s abagaoa "All you need to do is put a .mp3 file in the {i}music{/i} folder in the game directory, and click on the {i}Music{/i} tab in the bottom-left!"
    s abagaoa "你需要做的就是把.mp3文件放到game文件夹下的{i}music{/i}文件夹，然后点左下角的{i}音乐{/i}就好了！"

# game/dialogs/script-topics.rpy:2366
translate chinese s_event_music_intro_redux_3dc7798c:

    # s abagcka "I'm basically giving you the aux cord to the rest of my existence, so no pressure! Ehehehe~"
    s abagcka "毕竟我也是把余生的音频线都交给你了，所以不要有压力！欸嘿嘿~"

# game/dialogs/script-topics.rpy:2388
