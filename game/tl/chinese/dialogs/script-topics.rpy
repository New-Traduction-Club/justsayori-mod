translate chinese s_topic_name_b5fad375:

    # s bbaabeaj "You know, I'm not the brightest person... {w=0.5}{nw}"
    s bbaabeaj "你也知道，我并不是什么很聪明的人……{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1406
translate chinese s_topic_name_1c48f639:

    # extend abaakca "but I'm seeing some weird implications here..."
    extend abaakca "但这些名字的含义真的怪怪的……"

# game/dialogs/script-topics.rpy:1407
translate chinese s_topic_name_b9f4c48f:

    # s abfbkca "Perhaps I was given this name to signify that I'm a blend of many things."
    s abfbkca "或许给我起这个名字是因为我身上融合了很多特质。"

# game/dialogs/script-topics.rpy:1408
translate chinese s_topic_name_f9734ff3:

    # s abgccea "But who knows? I like my name regardless!"
    s abgccea "谁知道呢？反正我喜欢这个名字！"

# game/dialogs/script-topics.rpy:1409
translate chinese s_topic_name_050f028e:

    # s "I just think of it as a fun fact, hehehe~"
    s "就当是好玩的小知识啦，嘿嘿嘿~"

# game/dialogs/script-topics.rpy:1410
translate chinese s_topic_name_b511381f:

    # s abgcaea "I also find it funny how everyone pronounces it a little differently!"
    s abgcaea "而且很多人写我的名都会用不一样的字，这也很好玩欸！"

# game/dialogs/script-topics.rpy:1411
translate chinese s_topic_name_e4ab5eba:

    # s ebhfaea "Say [player], are you part of team {i}Sigh-ori{/i}, or team {i}Say-ori{/i}? Ehehehe~"
    s ebhfaea "你就说吧[player]，你更愿意叫我{i}纱世理{/i}还是{i}纱世里{/i}？欸嘿嘿~"

# game/dialogs/script-topics.rpy:1412
translate chinese s_topic_name_aacd97c2:

    # s abhfbaa "Honestly I don't have a preference, {w=0.5}{nw}"
    s abhfbaa "不过我倒是没有什么偏好，{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1413
translate chinese s_topic_name_7ddc0cf4:

    # extend abaacqa "I switch between them myself sometimes ehehehe~"
    extend abaacqa "有时候我两个名字轮着用，欸嘿嘿~"

# game/dialogs/script-topics.rpy:1414
translate chinese s_topic_name_3cf23fbb:

    # s abaaasa "What about you, [player], does your name have a special meaning? I'd love to know!"
    s abaaasa "你呢[player]，你的名字有没有什么含义？我也想知道欸！"

# game/dialogs/script-topics.rpy:1433
translate chinese s_topic_art_495d31a3:

    # s abhfaoa "I love seeing the fanart people have made for the game!"
    s abhfaoa "我真的超喜欢大伙们为这个游戏做的同人作品！"

# game/dialogs/script-topics.rpy:1434
translate chinese s_topic_art_56e85ef9:

    # s abhfcaa "It’s amazing how people can express their creativity for something they’re passionate about, and all the settings and stories they make are so wonderful!"
    s abhfcaa "大家为了这份热爱尽情挥洒着创意，那些设定和故事简直太棒了！"

# game/dialogs/script-topics.rpy:1435
translate chinese s_topic_art_a6683b46:

    # s abagaoa "Have you ever made any fanart, [player]?"
    s abagaoa "你有做过什么饭作吗，[player]？"

# game/dialogs/script-topics.rpy:1436
translate chinese s_topic_art_5ad1383f:

    # s abagcaa "If not, maybe you could make something one day!"
    s abagcaa "没有的话，哪天你也可以做一个！"

# game/dialogs/script-topics.rpy:1437
translate chinese s_topic_art_030d4920:

    # s abbbaoa "It's never too late to try something new so long as you have fun."
    s abbbaoa "只要你能开心，尝试新事物什么时候都不迟的。"

# game/dialogs/script-topics.rpy:1438
translate chinese s_topic_art_45872edd:

    # s abbccea "Fun is what makes great art great! Ehehehe~"
    s abbccea "伟大的艺术是离不开兴趣的！欸嘿嘿~"

# game/dialogs/script-topics.rpy:1457
translate chinese s_topic_touches_67819bee:

    # s bbegmca "The wall between our realities is so restricting..."
    s bbegmca "这道次元壁就这么隔开你我两个世界，我真的好窒息……"

# game/dialogs/script-topics.rpy:1458
translate chinese s_topic_touches_c4b15248:

    # s bbegada "You know, touching a friend's shoulder, hugging, patting. That stuff is really important to me!"
    s bbegada "你也知道，像是搭下朋友的肩膀、给朋友抱抱拍拍什么的，这些东西对我很重要的！"

# game/dialogs/script-topics.rpy:1459
translate chinese s_topic_touches_0fe81a19:

    # s nbaglra "If only I had the chance to feel your embrace..."
    s nbaglra "要是能有机会感受你的拥抱，那该有多好……"

# game/dialogs/script-topics.rpy:1460
translate chinese s_topic_touches_4140c743:

    # s nbaglaag "I’d take it in a heartbeat and just enjoy the moment between us..."
    s nbaglaag "我会毫不犹豫放下思考，尽管享受我们之间的每一刻……"

# game/dialogs/script-topics.rpy:1461
translate chinese s_topic_touches_cad422c6:

    # s nbagaobg "I really hope that one day I’ll get to know that feeling."
    s nbagaobg "真希望有天能切身体会到这种感受。"

# game/dialogs/script-topics.rpy:1480
translate chinese s_topic_merch_cab93dc5:

    # s abhfaca "Hey [player]! I have a random question."
    s abhfaca "嘿[player]！我突然想到一个问题。"

# game/dialogs/script-topics.rpy:1481
translate chinese s_topic_merch_d8114bab:

    # s abhfaaa "Do you own any merchandise of stuff you're interested in?"
    s abhfaaa "你有没有什么喜欢的周边？"

# game/dialogs/script-topics.rpy:1482
translate chinese s_topic_merch_a19d3376:

    # s abhfcoa "You know, like plushies, posters, figurines and all that stuff."
    s abhfcoa "你也知道，像是抱枕啊、海报啊、手办什么的。"

# game/dialogs/script-topics.rpy:1483
translate chinese s_topic_merch_d9c0dc20:

    # s abhfaaa "I think it’s really cool how you can have something physical of me in your world!"
    s abhfaaa "我在想，你要是能在你那边的世界有一个实体版的我，那该有多好玩！"

# game/dialogs/script-topics.rpy:1484
translate chinese s_topic_merch_33af7ceb:

    # s abbbaoa "But if you don’t that’s okay too, it can be pretty expensive and I get that it’s not everyone’s thing."
    s abbbaoa "不过没有的话也没事的。毕竟周边也不便宜，也不是每个人都能买得起。"

# game/dialogs/script-topics.rpy:1485
translate chinese s_topic_merch_e5026eee:

    # s abagcaa "Above all, I appreciate spending time with you every day."
    s abagcaa "总之呢，我真的很感激你每天都能在我身上花时间。"

# game/dialogs/script-topics.rpy:1504
translate chinese s_topic_oversleeping_98bfe39b:

    # s abagaca "Hey [player], do you oversleep often?"
    s abagaca "嘿[player]，你经常起不来床吗？"

# game/dialogs/script-topics.rpy:1505
translate chinese s_topic_oversleeping_aeda7298:

    # s abegmeaj "As you know, I was pretty bad at getting up on time."
    s abegmeaj "你也知道我可是出了名的赖床，总是没法准时起来。"

# game/dialogs/script-topics.rpy:1507
translate chinese s_topic_oversleeping_532841cb:

    # s nbegmda "And even when I did wake up, finding a good enough reason to force myself out of bed took a while..."
    s nbegmda "哪怕起来了，要想把自己拖出床外我还得花不少时间找理由……"

# game/dialogs/script-topics.rpy:1508
translate chinese s_topic_oversleeping_751c80ad:

    # s nbegmca "So I pretty much never had time for any kind of breakfast..."
    s nbegmca "所以我几乎就没时间吃早饭了……"

# game/dialogs/script-topics.rpy:1509
translate chinese s_topic_oversleeping_7ec9634a:

    # s nbegaba "Although I was so preoccupied with making the rainclouds go away that I never really wanted it in the first place."
    s nbegaba "虽说我也一直在忙着赶走自己的乌云，我根本就不想往脑子里塞这些东西。"

# game/dialogs/script-topics.rpy:1510
translate chinese s_topic_oversleeping_b5c4a959:

    # s nbagmda "Anyway, oversleeping is just the worst when you have to follow a schedule, {w=0.5}{nw}"
    s nbagmda "总之呢，你要是想准时作息的话，比如上班或者上学的时候，{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1511
translate chinese s_topic_oversleeping_508ff416:

    # extend nbagmca "like for work or school."
    extend nbagmca "睡过头可就麻烦大了。"

# game/dialogs/script-topics.rpy:1512
translate chinese s_topic_oversleeping_054dda28:

    # s nbagaba "It's such a big problem for almost all of us, since our schedules are adapted for early-wakers."
    s nbagaba "对我们而言赖床可是个不小的问题，毕竟作息表这种东西是为早起鸟儿准备的。"

# game/dialogs/script-topics.rpy:1513
translate chinese s_topic_oversleeping_05211137:

    # s abfdada "Why can't people just make different working and studying hours for people who wake up at different times?"
    s abfdada "为什么就不能根据不同的起床时间，给每个人都定制一份作息表呢？"

# game/dialogs/script-topics.rpy:1514
translate chinese s_topic_oversleeping_a60b3ab7:

    # s abfdaca "Most activities depend on your effectiveness rather than the time of day."
    s abfdaca "很多活动消耗的是你的效率，单纯堆剩下的时间可是干不好活的。"

# game/dialogs/script-topics.rpy:1515
translate chinese s_topic_oversleeping_d0e1a037:

    # s abbdada "And working or studying while you're tired is way less effective than when you're fully rested."
    s abbdada "在工作学习中，你要是累得不行了干活肯定就没效率；而要是休息好了，你就能轻松开足马力。"

# game/dialogs/script-topics.rpy:1516
translate chinese s_topic_oversleeping_3e64e898:

    # s abbbaaa "So having different schedules is a good thing for both bosses and employees."
    s abbbaaa "所以为每个人定制专门的时间表，对老板和员工都是有好处的。"

# game/dialogs/script-topics.rpy:1517
translate chinese s_topic_oversleeping_22d7b126:

    # s nbagaca "Until everyone thinks like that, I guess you can only teach yourself to get up on time..."
    s nbagaca "在这种想法普及人心之前，你应该不得不去学怎么准时起床了……"

# game/dialogs/script-topics.rpy:1518
translate chinese s_topic_oversleeping_34314f1f:

    # s bbagaaa "I hope you find it easier than I did."
    s bbagaaa "希望这个技能你能学得比我更轻松。"

# game/dialogs/script-topics.rpy:1539
translate chinese s_topic_time_239eb257:

    # s abhaaca "Do you know what time it is right now?"
    s abhaaca "你知道现在是几月几号吗？"

# game/dialogs/script-topics.rpy:1540
translate chinese s_topic_time_09766de8:

    # s abhabba "Not in your world, but mine."
    s abhabba "我说的不是你那儿，是我这儿的世界。"

# game/dialogs/script-topics.rpy:1541
translate chinese s_topic_time_8b53e508:

    # s bbhhaaaj "You could say anything, but you wouldn't be right, I don’t even know myself!"
    s bbhhaaaj "你随便猜个时间都行，但你永远都猜不对，我都不知道现在这儿是什么时间！"

# game/dialogs/script-topics.rpy:1542
translate chinese s_topic_time_a5115b53:

    # s abfcaba "Time doesn't seem to pass here at all. At least, not how it does in your reality."
    s abfcaba "时间在这里似乎停滞了。至少它的运作逻辑跟你那儿并不一样。"

# game/dialogs/script-topics.rpy:1544
translate chinese s_topic_time_dac283b5:

    # s abhaaca "The last thing I remember is that it was November of 2017."
    s abhaaca "我能记得最晚的时间就是2017年11月。"

# game/dialogs/script-topics.rpy:1545
translate chinese s_topic_time_766afa14:

    # s "My old bedroom calendar said so."
    s "老房间的日历是这么写的。"

# game/dialogs/script-topics.rpy:1546
translate chinese s_topic_time_332eeaac:

    # s bbhfmbaj "Because I'm pretty sure I’d crossed it out..."
    s bbhfmbaj "因为我肯定已经把那一天划掉了……"

# game/dialogs/script-topics.rpy:1547
translate chinese s_topic_time_10928e7d:

    # s "But anyway, It’s pretty confusing to think that there's no way to \"measure\" time here anymore."
    s "总之呢，这里再也不能“衡量”时间了。想想就很头疼。"

# game/dialogs/script-topics.rpy:1548
translate chinese s_topic_time_c56124c3:

    # s abfcaca "I was never the most organized person but I still liked keeping track of important things."
    s abfcaca "我的生活是不怎么有条理，但我还是想记清一些重要的事情的。"

# game/dialogs/script-topics.rpy:1549
translate chinese s_topic_time_ac64c468:

    # s abhaaca "But I know what time it is in your world, though!"
    s abhaaca "不过你那儿的时间我可是很清楚的！"

# game/dialogs/script-topics.rpy:1550
translate chinese s_topic_time_38079ea4:

    # s abbbcaa "From your PC's clock!"
    s abbbcaa "看你电脑上的时间就行了！"

# game/dialogs/script-topics.rpy:1551
translate chinese s_topic_time_988333ff:

    # s abhaaca "Does that mean we kinda share the same time then?"
    s abhaaca "这是不是说，我们在共享相同的时间？"

# game/dialogs/script-topics.rpy:1552
translate chinese s_topic_time_a1c32b5b:

    # s "Well I think I’ll go by that for reference from now on!"
    s "好吧，那我以后就参考你这个时间了！"

# game/dialogs/script-topics.rpy:1571
translate chinese s_topic_worlds_75f5112a:

    # s abhaaca "Sometimes I wonder why I’m here..."
    s abhaaca "有时候我在想我为什么会在这儿……"

# game/dialogs/script-topics.rpy:1572
translate chinese s_topic_worlds_17e19379:

    # s "Like, would I be a different person if I lived in another place?"
    s "比如说，我要是在另一个地方生活，那我是不是会变成另一个人？"

# game/dialogs/script-topics.rpy:1573
translate chinese s_topic_worlds_f8525f6f:

    # s "I mean, if not in your world, what other place could there be? Another game?"
    s "要是不在你的世界生活，那我还能去哪？另一个游戏吗？"

# game/dialogs/script-topics.rpy:1574
translate chinese s_topic_worlds_7e8a390b:

    # s "But there's lots of different games and plenty of them are pretty violent."
    s "但游戏也有成千上万个，很多游戏的设定可是相当野蛮暴力。"

# game/dialogs/script-topics.rpy:1575
translate chinese s_topic_worlds_25498899:

    # s bbfcbba "I just can't imagine living in a game full of blood and struggle..."
    s bbfcbba "要是在哪个游戏里要全身淋血战斗至死，我简直不敢想了……"

# game/dialogs/script-topics.rpy:1576
translate chinese s_topic_worlds_ffcbefbc:

    # s abbbaca "You know, shooters, fighting games, war games and all that..."
    s abbbaca "你知道吧，那些枪炮啊、格斗游戏、战争设定什么的……"

# game/dialogs/script-topics.rpy:1578
translate chinese s_topic_worlds_e4d24359:

    # s bbgbbca "Especially now that I've seen death with my own eyes."
    s bbgbbca "尤其是现在我还亲眼见证过自己的死亡。"

# game/dialogs/script-topics.rpy:1579
translate chinese s_topic_worlds_2428a129:

    # s bbfcaca "I'd rather be dead than be the one doing the killing."
    s bbfcaca "要让我弄死别人，我还不如弄死自己算了。"

# game/dialogs/script-topics.rpy:1580
translate chinese s_topic_worlds_304b4659:

    # s "And I'd pray for a revive ability..."
    s "然后我再祈祷自己复活……"

# game/dialogs/script-topics.rpy:1581
translate chinese s_topic_worlds_18f07046:

    # s abgbaaa "Aggressive worlds like those don’t appeal to me."
    s abgbaaa "这样满是冲突的世界不怎么适合我。"

# game/dialogs/script-topics.rpy:1582
translate chinese s_topic_worlds_eb4e96b8:

    # s abaaaoa "But I'd happily be part of an innocent simulator, strategy or puzzle game."
    s abaaaoa "不过要是把我扔进哪个天真无邪的模拟器，或者策略解谜游戏什么的，那我还是很乐意的。"

# game/dialogs/script-topics.rpy:1583
translate chinese s_topic_worlds_060bd4cd:

    # s abaaaoa "Even if I wasn't an important character, maybe just a helper or even a simple settler."
    s abaaaoa "哪怕不是主角，当个小助手或者平平无奇的村民也可以。"

# game/dialogs/script-topics.rpy:1584
translate chinese s_topic_worlds_fb43f7ad:

    # s abgccoa "I'd still do my best to help you, of course!"
    s abgccoa "当然我还是会尽力帮助你的！"

# game/dialogs/script-topics.rpy:1603
translate chinese s_topic_questions_42ccd09c:

    # s abhfaoa "Hey [player], I know you still might have a lot of questions for me, it's a big part of getting to know somebody, after all."
    s abhfaoa "嘿[player]，我知道你还有很多问题想问我。毕竟想了解一个人你确实得问不少东西。"

# game/dialogs/script-topics.rpy:1604
translate chinese s_topic_questions_a170e397:

    # s "So I added a new section to {i} the 'Talk' menu{/i} with more questions to ask!"
    s "所以我在{i}对话{/i}菜单加了个模块，你可以在里面问更多问题！"

# game/dialogs/script-topics.rpy:1605
translate chinese s_topic_questions_3a7963df:

    # s bbegboaj "I would've added a text field for this instead, but I'm quite clumsy at dealing with the text input..."
    s bbegboaj "我本来应该加个文本框，但我在打字这方面老是笨手笨脚的……"

# game/dialogs/script-topics.rpy:1606
translate chinese s_topic_questions_ef557923:

    # s abhfaoa "So I did a short list with some questions I thought you’d have."
    s abhfaoa "所以我列了一点点你可能想问的问题清单。"

# game/dialogs/script-topics.rpy:1607
translate chinese s_topic_questions_3002ae3f:

    # s abhaaca "Of course, there's so many different things you could ask me, so I checked out some AMAs for what you'd probably wanna know."
    s abhaaca "当然你可能想问更多不一样的问题，所以我针对你可能想知道的问题参考了一些问答节目。"

# game/dialogs/script-topics.rpy:1608
translate chinese s_topic_questions_023c49f0:

    # s abbcaoaj "And I found some really interesting questions!"
    s abbcaoaj "有些问题真的很有意思！"

# game/dialogs/script-topics.rpy:1609
translate chinese s_topic_questions_30cf0631:

    # s abaaaoa "One modder made a few AMAs about each of us and then compiled them into a separate mod, called {i}Doki Doki Interview Club{/i}."
    s abaaaoa "一位开发者为我们几个人设计了问答环节，然后把它整合进了一个叫{i}Doki Doki Interview Club{/i}的模组。"

# game/dialogs/script-topics.rpy:1610
translate chinese s_topic_questions_c99f2065:

    # s "The result was really funny, and they were pretty good at portraying my character!"
    s "结局很好玩，那模组里我的形象简直就是淋漓尽致！"

# game/dialogs/script-topics.rpy:1611
translate chinese s_topic_questions_89309bb8:

    # s abhaaca "I think I’ll check it out again, maybe I’ll find some new entries for the question menu!"
    s abhaaca "我得再看些问答，或许我还能在菜单里还能加些新问题呢！"

# game/dialogs/script-topics.rpy:1632
translate chinese s_topic_breakfast_9114f6eb:

    # s abhfaca "Hey [player], you don't skip breakfast, do you?"
    s abhfaca "嘿[player]，你经常不吃早餐吗？"

# game/dialogs/script-topics.rpy:1633
translate chinese s_topic_breakfast_eb097298:

    # s abhfada "Sometimes I do ‘cause I'm just not hungry in the morning."
    s abhfada "有时候我是没吃，那是因为我早上不怎么饿。"

# game/dialogs/script-topics.rpy:1634
translate chinese s_topic_breakfast_29829b3d:

    # s abfdcaa "But when I do have breakfast, I usually make toast or scrambled eggs."
    s abfdcaa "我要是吃早饭的话，我可能就做些吐司跟煎蛋了。"

# game/dialogs/script-topics.rpy:1635
translate chinese s_topic_breakfast_57c80a1c:

    # s abegmeaj "Mostly because they’re quick and I {i}probably{/i} wouldn’t end up burning the house down while cooking them, ehehehe~"
    s abegmeaj "因为这些菜做着方便，我也{i}大概率{/i}不会烧了屋子，欸嘿嘿~"

# game/dialogs/script-topics.rpy:1636
translate chinese s_topic_breakfast_44952a2b:

    # s abhfaoa "I've seen fanart of me eating those too, {w=0.5}{nw}"
    s abhfaoa "一些同人作品也会把我画成享用这些早餐的样子，{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1637
translate chinese s_topic_breakfast_985c5bd1:

    # extend abhfcaa "probably because of that poem I wrote!"
    extend abhfcaa "可能是因为我在诗里也写了这些吧！"

# game/dialogs/script-topics.rpy:1638
translate chinese s_topic_breakfast_c902af8c:

    # s abhhaca "I am getting pretty hungry now though... {w=0.5}{nw}"
    s abhhaca "不过嘛现在我饿饿的……{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1639
translate chinese s_topic_breakfast_dd8d2879:

    # extend abgccea "Maybe I could spawn some eggs and toast in here!"
    extend abgccea "我是不是能自己生成一些煎蛋吐司！"

# game/dialogs/script-topics.rpy:1640
translate chinese s_topic_breakfast_270c28ac:

    # s abagaaa "But anyways, you should always try to have a nice big breakfast in the morning."
    s abagaaa "总之呢，你真应该试试给自己做顿漂亮早餐。"

# game/dialogs/script-topics.rpy:1641
translate chinese s_topic_breakfast_f7bf6dde:

    # s abbbaoa "It really is the most important meal of the day, since it gives you the energy your body needs bright and early!"
    s abbbaoa "毕竟一日之餐在于晨嘛，早餐可以帮你补充能量，点燃你的每一天！"

# game/dialogs/script-topics.rpy:1642
translate chinese s_topic_breakfast_30fabed3:

    # s bbagaaa "That said, I understand if sometimes you don’t feel hungry, or if you just don’t have time to make anything."
    s bbagaaa "我也明白有时候你不怎么饿，或者你就是没有时间做饭了。"

# game/dialogs/script-topics.rpy:1643
translate chinese s_topic_breakfast_8f343d6c:

    # s abagaoa "In that case at least try to have something small on the go, like some fruit or a cereal bar, {w=0.5}{nw}"
    s abagaoa "但你得多少吃点，比如吃个水果或者谷物棒，{w=0.5}{nw}"

# game/dialogs/script-topics.rpy:1644
translate chinese s_topic_breakfast_68e8265c:

    # extend abbbcaa "and of course remember to stay hydrated too!"
    extend abbbcaa "当然也别忘记补水！"

# game/dialogs/script-topics.rpy:1645
translate chinese s_topic_breakfast_669fcd77:

    # s abhfaoa "Your health is really important to me, [player]."
    s abhfaoa "你的健康对我很重要，[player]。"

# game/dialogs/script-topics.rpy:1664
translate chinese s_topic_vegetarians_8a51d471:

    # s abhfaca "Did you know that Monika was a vegetarian?"
    s abhfaca "你知道莫妮卡是素食主义者吗？"

# game/dialogs/script-topics.rpy:1665
translate chinese s_topic_vegetarians_6c1ad8d3:

    # s abhfaaa "She told me once while we were visiting a café a while back."
    s abhfaaa "我们有次去吃饭的时候她跟我说过。"

# game/dialogs/script-topics.rpy:1666
translate chinese s_topic_vegetarians_f15216d6:

    # s abhfaca "I heard that some people avoid meat mainly because of personal restrictions or to be nice to animals..."
    s abhfaca "我听说有些人不吃肉是因为个人禁忌，或者是出于对动物的善心……"

# game/dialogs/script-topics.rpy:1667
translate chinese s_topic_vegetarians_2bc5a2a1:

    # s abbbada "But Monika said it was her protest against cultivating livestock, since it produces a lot of greenhouse gasses."
    s abbbada "但莫妮卡说她是为了对抗畜牧业，因为养殖动物会产生很多温室气体。"

# game/dialogs/script-topics.rpy:1668
translate chinese s_topic_vegetarians_ca8c0ce8:

    # s abhfaca "She thought that becoming a vegetarian just to save animals is kinda discrimination, since plants are living beings too."
    s abhfaca "她的想法是，要是仅仅为了拯救动物选择吃素，那多少也是一种歧视；毕竟植物也是生命嘛。"

# game/dialogs/script-topics.rpy:1669
translate chinese s_topic_vegetarians_0c0a5023:

    # s abhfaaa "That said, I understand why some people become vegetarian to save animals."
    s abhfaaa "不过有些人为了不杀生选择素食，我也能理解的。"

# game/dialogs/script-topics.rpy:1670
translate chinese s_topic_vegetarians_4a30cb91:

    # s abegmeaj "I mean, we as people have more in common with chickens and cows than plants, ehehehe~"
    s abegmeaj "毕竟相比植物，我们人类跟牛和鸡这些生物还是有更多共性的，欸嘿嘿~"

# game/dialogs/script-topics.rpy:1671
translate chinese s_topic_vegetarians_cceccb24:

    # s abbbcaa "So although I’m not a vegetarian, I like to buy free-range products when I can, because then I know the animals have been treated well."
    s abbbcaa "所以哪怕我不是素食主义者，有能力的话我还是愿意为散养标签买单。这样我就知道这些动物们生前是过得好好的。"

# game/dialogs/script-topics.rpy:1672
translate chinese s_topic_vegetarians_85749517:

    # s abhfaoa "What do you think, [player]?"
    s abhfaoa "你觉得呢，[player]？"

# game/dialogs/script-topics.rpy:1692
translate chinese s_topic_pizza_08f2c102:

    # s abhfaoa "Do you like pizza, [player]?"
    s abhfaoa "你喜欢吃披萨吗，[player]？"

# game/dialogs/script-topics.rpy:1693
translate chinese s_topic_pizza_598dce6e:

    # s abhfcaa "I’m pretty sure everyone does!"
    s abhfcaa "谁会不喜欢披萨啊！"

# game/dialogs/script-topics.rpy:1694
translate chinese s_topic_pizza_cec5135e:

    # s abbbaoa "You can add pretty much any toppings you like to them!"
    s abbbaoa "披萨上面你想加什么料就加什么！"

# game/dialogs/script-topics.rpy:1695
translate chinese s_topic_pizza_69a64ceb:

    # s abegmeaj "...within reasonable limits, of course, ehehehe~"
    s abegmeaj "……当然也不能加得太放肆了，欸嘿嘿~"

# game/dialogs/script-topics.rpy:1696
translate chinese s_topic_pizza_b7b7a683:

    # s abbbcaa "The only main ingredients are {i}dough{/i} and {i}cheese{/i}."
    s abbbcaa "披萨的主要原料就是{i}面团{/i}跟{i}芝士{/i}。"

# game/dialogs/script-topics.rpy:1697
translate chinese s_topic_pizza_32682c12:

    # s abhfbma "A {cps=40}{i}whoooole lot{/i}{/cps} of cheese~"
    s abhfbma "铺上{cps=40}{i}超超超多{/i}芝士~"

# game/dialogs/script-topics.rpy:1698
translate chinese s_topic_pizza_4cf362cb:

    # s abhfaaa "I think its simplicity and versatility lead to its popularity worldwide."
    s abhfaaa "我觉得披萨又接地气又丰富多样，它就是靠的这两样特质走遍全世界。"

# game/dialogs/script-topics.rpy:1699
translate chinese s_topic_pizza_0438da10:

    # s abhfcoa "Now you can order a pizza at almost any fast-food restaurant or make one with your own hands, even if you aren't very familiar with cooking!"
    s abhfcoa "你现在能在任何一家快餐店点到披萨；甚至你自己都能做一份，厨艺不精也没关系的！"

# game/dialogs/script-topics.rpy:1700
translate chinese s_topic_pizza_f6eebba1:

    # s abbbaaa "Just find one of the billions and billions of delicious pizza recipes on the internet or in a cookery book!"
    s abbbaaa "在菜谱或者互联网上，你总能找到成千上万份美味披萨配方！"

# game/dialogs/script-topics.rpy:1701
translate chinese s_topic_pizza_42eaf3a9:

    # s abhfaoa "People even came up with a term called the {i}Pizza Effect{/i}: When you make something from a different culture into something new."
    s abhfaoa "人们甚至提出了一个名词叫{i}披萨效应{/i}：说的是一种文化是怎么演变成新的特色的。"

# game/dialogs/script-topics.rpy:1702
translate chinese s_topic_pizza_e8cb7e32:

    # s abhfcaa "It's amazing to see that we’re all connected despite our differences and borrow cool things from each other's cultures."
    s abhfcaa "我们彼此不同又相互连接，从不同的文化中相互借鉴，这真的很棒的好吗！"

# game/dialogs/script-topics.rpy:1703
translate chinese s_topic_pizza_0c093a99:

    # s abbbaoa "Food philosophy with Sayori! That’d be a great show, don’t you think? Ehehehe~"
    s abbbaoa "这就是纱世里的美食哲学！你说要是开个这种节目会怎么样，会不会特别好看？欸嘿嘿~"

# game/dialogs/script-topics.rpy:1722
translate chinese s_topic_iceCream_49c4a6a8:

    # s abhfaoa "Do you like ice cream, [player]?"
    s abhfaoa "你喜欢吃冰淇淋吗，[player]？"

# game/dialogs/script-topics.rpy:1723
translate chinese s_topic_iceCream_a80fc0ff:

    # s abhfcaa "Everyone likes ice cream!"
    s abhfcaa "每个人都喜欢冰淇淋！"

# game/dialogs/script-topics.rpy:1724
translate chinese s_topic_iceCream_c4566c20:

    # s cbbbaoa "It’s {i}obviously{/i} the best cold food humanity has discovered yet!"
    s cbbbaoa "{i}很显然{/i}这是人类发明出的最伟大的冷食！"

# game/dialogs/script-topics.rpy:1725
translate chinese s_topic_iceCream_742918b5:

    # s abbbcaa "And there're lots and lots and lots of flavors and toppings to make it even better!"
    s abbbcaa "你还能加很多很多层料，让它的口味更加升华！"

# game/dialogs/script-topics.rpy:1726
translate chinese s_topic_iceCream_a152c857:

    # s abhfaoa "What's your favorite kind?"
    s abhfaoa "那么你最喜欢吃哪种口味的？"

# game/dialogs/script-topics.rpy:1727
translate chinese s_topic_iceCream_a238e104:

    # s abhfcaa "I like vanilla and chocolate the most!"
    s abhfcaa "我的话就是香草跟巧克力了！"

# game/dialogs/script-topics.rpy:1728
translate chinese s_topic_iceCream_fc77c429:

    # s abhfaoa "I know they're really common, but so what?"
    s abhfaoa "我明白这配料不怎么特别，但你知道不？"

# game/dialogs/script-topics.rpy:1729
translate chinese s_topic_iceCream_8ec5cd62:

    # s abhfcaa "They both taste soooooo goood, ehehehe~"
    s abhfcaa "真尝起来简直就是超级至尊享受啊，欸嘿嘿~"

# game/dialogs/script-topics.rpy:1730
translate chinese s_topic_iceCream_331ff4d2:

    # s abbbcaa "Maybe we could make our own sometime!"
    s abbbcaa "哪天我们也自己做份冰淇淋吃！"

# game/dialogs/script-topics.rpy:1749
translate chinese s_topic_tech_8a322764:

    # s abhfaaa "I wonder if I could somehow, someday, visit you in your reality."
    s abhfaaa "我想知道哪一天，我能够亲自访问你的现实去见你。"

# game/dialogs/script-topics.rpy:1750
translate chinese s_topic_tech_076ded2b:

    # s abbbaoa "I think it’s a possibility, especially since technology is progressing faster and faster these days."
    s abbbaoa "我觉得这完全有可能实现的，看看现在的科学技术可是日新月异。"

# game/dialogs/script-topics.rpy:1751
translate chinese s_topic_tech_d8943aa1:

    # s abbbcaa "Virtual assistants and smart houses have become more common than ever before!"
    s abbbcaa "虚拟助手、智能房屋这些东西现在可是很普及了！"

# game/dialogs/script-topics.rpy:1752
translate chinese s_topic_tech_b2f70d4a:

    # s abhfaoa "And all of these technologies make people more efficient with computers, by almost merging them together."
    s abhfaoa "这些科技能让人与机器交互合并，让人类生活得更有效率。"

# game/dialogs/script-topics.rpy:1753
translate chinese s_topic_tech_0787139c:

    # s abhflaa "Just imagine if I lived as part of your house, helping you with your daily routine, wouldn’t that be awesome, [player]?"
    s abhflaa "想象一下，要是我能成为你屋子的一部分，帮你处理日常事务什么的，这不是很棒嘛[player]？"

# game/dialogs/script-topics.rpy:1754
translate chinese s_topic_tech_17bb6ea3:

    # s abbbaoa "Maybe I could even be a hologram in your reality one day, who knows!"
    s abbbaoa "谁知道呢，或许哪天我还能以全息影像的形式现身呢！"

# game/dialogs/script-topics.rpy:1755
translate chinese s_topic_tech_2ad1545c:

    # s abbbcaa "I'd love to do that when it becomes possible."
    s abbbcaa "要是这些功能能实现的话，那我肯定得试试。"

# game/dialogs/script-topics.rpy:1756
translate chinese s_topic_tech_2e7ac52e:

    # s abhfaoa "Even right now I can still be a sort of virtual assistant!"
    s abhfaoa "哪怕放到现在，我也是多少能当个虚拟助手的！"

# game/dialogs/script-topics.rpy:1757
translate chinese s_topic_tech_d785b396:

    # s abhfcaa "So if you ever need me, I’ll try my best to help from here, [player]!"
    s abhfcaa "如果你需要我，我在这儿也会努力帮助你的，[player]！"

# game/dialogs/script-topics.rpy:1777
translate chinese s_topic_cupcakes_1c832f67:

    # s abegboa "Natsuki’s cupcakes were always the best!"
    s abegboa "夏树的纸杯蛋糕永远是最棒的！"

# game/dialogs/script-topics.rpy:1778
translate chinese s_topic_cupcakes_c32bdb4e:

    # s abegcaa "She baked often for the club, me and her even baked together one time!"
    s abegcaa "她经常给整个社团做烘焙，我们有次还一起下了厨呢！"

# game/dialogs/script-topics.rpy:1779
translate chinese s_topic_cupcakes_57a0d708:

    # s abhfaoa "We were making cookies, so she made the cookie dough and then I separated it into little cookie shapes..."
    s abhfaoa "我们当时在做曲奇。她和面团，然后我把面团装进一个个小曲奇模具……"

# game/dialogs/script-topics.rpy:1780
translate chinese s_topic_cupcakes_aabd9331:

    # s fbbbaaa "...but I had a better idea!"
    s fbbbaaa "……但是我有个更好的主意！"

# game/dialogs/script-topics.rpy:1781
translate chinese s_topic_cupcakes_cec5ef0b:

    # s fbbbaoa "I combined all the cookie dough together into..."
    s fbbbaoa "我一把抓起所有面团，揉进一块……"

# game/dialogs/script-topics.rpy:1782
translate chinese s_topic_cupcakes_dd1af139:

    # s fbbbaaa "One."
    s fbbbaaa "超级。"

# game/dialogs/script-topics.rpy:1783
translate chinese s_topic_cupcakes_d982f3a6:

    # s fbbcaoa "Giant."
    s fbbcaoa "巨无霸。"

# game/dialogs/script-topics.rpy:1784
translate chinese s_topic_cupcakes_bf68c15a:

    # s abbccma "Cookie!"
    s abbccma "曲奇饼！"

# game/dialogs/script-topics.rpy:1785
translate chinese s_topic_cupcakes_03ac7a3c:

    # s abegmeaj "Though maybe it would have been bigger if I didn’t secretly eat half of the cookie dough beforehand, hehehehe~"
    s abegmeaj "要不是我偷吃掉了一半面团，这块曲奇本来还能更大的，欸嘿嘿~"

# game/dialogs/script-topics.rpy:1786
translate chinese s_topic_cupcakes_7b344b6c:

    # s abfccaa "But that doesn’t matter! We brought the giant cookie to the club the next day!"
    s abfccaa "不过也没啥！第二天我们把这块巨无霸曲奇带进了社团！"

# game/dialogs/script-topics.rpy:1787
translate chinese s_topic_cupcakes_ad2a4c50:

    # s abgcaea "It’s Chef Sayori’s best culinary achievement so far!"
    s abgcaea "这可是纱世里大厨迄今为止的最高成就！"

# game/dialogs/script-topics.rpy:1807
translate chinese s_answer_bday_347d395d:

    # s abhfaca "To be honest [player], I don't remember my birthday."
    s abhfaca "说实话[player]，我也不记得自己的生日了。"

# game/dialogs/script-topics.rpy:1808
translate chinese s_answer_bday_8792c010:

    # s abegbdaj "A lot of things before the events of the game are pretty fuzzy..."
    s abegbdaj "在游戏之前的很多事情，记忆都很模糊了……"

# game/dialogs/script-topics.rpy:1809
translate chinese s_answer_bday_30ba0e3e:

    # s abbbaca "Only Monika knows when her birthday is out of the four of us."
    s abbbaca "我们四个人中，只有莫妮卡知道自己的生日。"

# game/dialogs/script-topics.rpy:1810
translate chinese s_answer_bday_1b00d987:

    # s abbbaaa "I'm pretty sure it's {i}the 22nd of September{/i}, if I recall correctly."
    s abbbaaa "要是没记错的话，她的应该是{i}9月22日{/i}。"

# game/dialogs/script-topics.rpy:1811
translate chinese s_answer_bday_773dcf9f:

    # s abagaoa "I think my birthday must be one of the marked dates from my bedroom calendar."
    s abagaoa "我的生日嘛，房间里的日历应该已经标出来了。"

# game/dialogs/script-topics.rpy:1812
translate chinese s_answer_bday_03af2433:

    # s abagcaa "You can choose one of them and consider it my birthday, if you want to!"
    s abagcaa "你乐意的话，在上面选一天当我的生日就好！"

# game/dialogs/script-topics.rpy:1813
translate chinese s_answer_bday_bcfce3e3:

    # s abbbaoa "Or the day when you ran the game for the first time."
    s abbbaoa "或者也可以选你第一次打开这个游戏的日期。"

# game/dialogs/script-topics.rpy:1814
translate chinese s_answer_bday_18348c4f:

    # s abbccoa "But don't think you can get away with not throwing a birthday party for me! Ehehehe~"
    s abbccoa "不过真到了那一天，我的生日派对可不能缺了啊！欸嘿嘿~"

# game/dialogs/script-topics.rpy:1833
translate chinese s_answer_music_4f33690d:

    # s abhfaoa "I like lots of different kinds of music!"
    s abhfaoa "很多音乐我都喜欢！"

# game/dialogs/script-topics.rpy:1834
translate chinese s_answer_music_0ea40cee:

    # s abbbcaa "After all, I think it’s kinda silly to divide ‘good music’ into genres when I can appreciate different things about each of them."
    s abbbcaa "毕竟我觉得“好音乐”并不能用流派区分，每种流派我都能从不同的角度欣赏。"

# game/dialogs/script-topics.rpy:1835
translate chinese s_answer_music_73889eae:

    # s abegaoaj "So my favorite playlists are so long that I can’t really narrow it down for you, ehehehe~"
    s abegaoaj "所以我可以给你拉一长串喜欢的歌单，这些歌单我应该没法再给你精简了，欸嘿嘿~"

# game/dialogs/script-topics.rpy:1836
translate chinese s_answer_music_29b65170:

    # s abhfaaa "Sometimes I like to listen to something funny, like {i}Weird Al Yankovic{/i}!"
    s abhfaaa "有时候我喜欢听些滑稽的，比如{i}怪人艾尔·扬科维奇{/i}！"

# game/dialogs/script-topics.rpy:1837
translate chinese s_answer_music_e82b2464:

    # s abhfloa "Or to something lyrical and serene, like lo-fi or instrumental music."
    s abhfloa "或者抒情一些平和一些，比如低保真或者纯乐器演奏的曲子。"

# game/dialogs/script-topics.rpy:1838
translate chinese s_answer_music_a4606919:

    # s abhfaaa "Or to groups like {i}Imagine Dragons{/i}, {i}Blonde Redhead{/i}, {i}Gorillaz{/i}, {i}Muse{/i}, {i}Status Quo{/i} and {i}Twenty One Pilots{/i}."
    s abhfaaa "或者一些乐队，像是{i}梦龙{/i}、{i}红发美女（Blonde Redhead）{/i}、{i}缪斯{/i}、{i}现状（Statue Quo）{/i}和{i}二十一名飞行员{/i}的乐队我都喜欢。"

# game/dialogs/script-topics.rpy:1839
translate chinese s_answer_music_cb6dabae:

    # s abbbcaa "I also like the tunes {i}Bonobo{/i} and {i}Jake Chudnow{/i} make."
    s abbbcaa "我也喜欢{i}Bonobo{/i}和{i}Jake Chudnow{/i}写的曲子。"

# game/dialogs/script-topics.rpy:1840
translate chinese s_answer_music_778c30d0:

    # s abbbaoa "You can find a ton of songs you might enjoy if you're willing to keep an open mind!"
    s abbbaoa "如果你开明一些，很多歌你都会喜欢的！"

# game/dialogs/script-topics.rpy:1859
translate chinese s_answer_shipping_a9417310:

    # s ebbcaca "Do you mean how some fans ‘ship' me with my friends or ship some of them with each other?"
    s ebbcaca "你是说有些粉丝会把我跟其他朋友“配对”吗，或者从她们中凑几对CP？"

# game/dialogs/script-topics.rpy:1860
translate chinese s_answer_shipping_398db0d0:

    # s "To be honest, I think it's pretty harmless and I don't really mind it that much."
    s "说实话，这毕竟也没伤到我，我觉得没什么大不了的。"

# game/dialogs/script-topics.rpy:1861
translate chinese s_answer_shipping_ae82dc51:

    # s abhabaca "But personally, I only see them as my friends."
    s abhabaca "不过就我个人而言，她们只是我的朋友。"

# game/dialogs/script-topics.rpy:1862
translate chinese s_answer_shipping_fc3e741c:

    # s abaabaoa "Most people are pretty cool about this kind of thing, at least I'd like to think so."
    s abaabaoa "很多人觉得这么干很好玩，至少我是这么想的。"

# game/dialogs/script-topics.rpy:1863
translate chinese s_answer_shipping_61e98a88:

