translate chinese s_poem_last_13a1f2d0:

    # s bbhamgc "It makes me feel... icky, maybe? {w=0.5}{nw}"
    s bbhamgc "我大概感觉很……作呕，知道吧？{w=0.5}{nw}"

# game/dialogs/script-poemresponses.rpy:99
